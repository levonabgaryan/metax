# Template for .env. Copy to `.env` and fill in real values for prod.
#
# IMPORTANT:
# * DevConfigs IGNORES .env entirely - dev uses class-level defaults baked
#   into metax_configs.py and matches docker-compose.dev.yml. You do NOT need
#   .env for `ENV=dev`. Set `ENV=dev` in your shell or IDE run configuration.
# * TestConfigs also ignores .env. CI passes everything via Compose-level env
#   from docker-compose.test.yml.
# * ProdConfigs DOES read .env. All values below must be present and valid.

ENV=dev

# Backend / Django
DJANGO_SECRET_KEY=
DJANGO_SERVER_HOST=0.0.0.0
DJANGO_SERVER_PORT=8000

# PostgreSQL
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Redis
REDIS_SERVER_HOST=metax-redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Logging (fluent-bit)
FLUENT_BIT_HOST=
FLUENT_BIT_PORT=

# Embeddings for vector search (served by the metax-embeddings sentence-transformers container).
# The served model is fixed in docker-compose.base.yml; only the host/dims are configured here.
EMBEDDING_HOST=http://metax-embeddings:80
EMBEDDING_DIM=1024
EMBEDDING_CONCURRENCY=6
EMBEDDING_TIMEOUT=120.0

# Embedding-based product category classification during crawling (no LLM); always on.
# Max cosine distance to assign a category (lower = stricter).
CATEGORY_MATCH_MAX_DISTANCE=0.40

# Embed newly collected products (for search) right after a crawl. Set false to make a crawl
# just load raw data into the DB fast; embed later with scripts/backfill_embeddings.py.
EMBED_AFTER_COLLECT=true

# Max seconds a crawl may hold the global collection lock (which serializes the nightly all-retailers
# run and any manual single-retailer run) before Redis auto-expires it. Must exceed the longest run.
COLLECTION_LOCK_TTL_SECONDS=3600

# Telegram Bot (optional — only required when running run_metax_telegram_bot.py)
TELEGRAM_BOT_TOKEN=
